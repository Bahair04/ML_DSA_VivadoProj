# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y2 [get_cells tmp_reg_reg[183]_i_1]
set_property LOC BUFGCTRL_X0Y1 [get_cells tmp_reg_reg[160]_i_2]
set_property LOC BUFGCTRL_X0Y0 [get_cells clk_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y78 [get_ports clk]

# Clock net "u_ExpandS/tmp_reg__0" driven by instance "tmp_reg_reg[183]_i_1" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_u_ExpandS/tmp_reg__0}
add_cells_to_pblock [get_pblocks  {CLKAG_u_ExpandS/tmp_reg__0}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_ExpandS/tmp_reg__0"}]]]
resize_pblock [get_pblocks {CLKAG_u_ExpandS/tmp_reg__0}] -add {CLOCKREGION_X0Y3:CLOCKREGION_X0Y3}
#endgroup

# Clock net "u_ExpandA/tmp_reg__0" driven by instance "tmp_reg_reg[160]_i_2" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_u_ExpandA/tmp_reg__0}
add_cells_to_pblock [get_pblocks  {CLKAG_u_ExpandA/tmp_reg__0}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_ExpandA/tmp_reg__0"}]]]
resize_pblock [get_pblocks {CLKAG_u_ExpandA/tmp_reg__0}] -add {CLOCKREGION_X1Y3:CLOCKREGION_X1Y3}
#endgroup

# Clock net "clk_IBUF_BUFG" driven by instance "clk_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y0"
